---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="페이지를 찾을 수 없음" description="요청한 페이지가 이 로그에는 기록되어 있지 않습니다.">
  <section class="wrap notfound">
    <p class="eyebrow">404</p>
    <h1>이 궤적은 기록에 없습니다</h1>
    <p>요청한 페이지를 찾을 수 없습니다. 궤도를 이탈한 것 같으니, 로그로 돌아가세요.</p>
    <a class="cta" href="/">← 로그로 돌아가기</a>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(4rem, 12vw, 8rem);
    text-align: center;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }

  p {
    color: var(--ink-soft);
    max-width: 45ch;
    margin-inline: auto;
  }

  .cta {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    padding: 0.6rem 1.1rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .cta:hover {
    background: var(--amber);
  }
</style>
