---
import BaseLayout from '../layouts/BaseLayout.astro';
import SystemAxis from '../components/SystemAxis.astro';
import ProjectRows from '../components/ProjectRows.astro';
import { getProjects } from '../lib/content';
const projects = getProjects();
---
<BaseLayout title="프로젝트">
  <div class="page-head">
    <h1>프로젝트</h1>
    <p class="measure muted">재료과학과 소프트웨어 작업을 함께 모았습니다. 각 항목은 원본 저장소로 연결합니다.</p>
  </div>
  <SystemAxis projects={projects}/>
  <section class="section" aria-label="프로젝트 목록">
    {projects.length
      ? <ProjectRows projects={projects} detailed/>
      : <p class="empty">소개할 프로젝트를 정리하고 있습니다.</p>}
  </section>
</BaseLayout>
