---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import FieldMark from '../../components/FieldMark.astro';
import { getProjects, type Project } from '../../lib/content';
import { playground } from '../../lib/playground';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      previous: projects[index - 1],
      next: projects[index + 1],
    },
  }));
}

interface Props {
  project: Project;
  previous?: Project;
  next?: Project;
}
const { project, previous, next } = Astro.props;
const { Content } = await render(project);
const { title, summary, period, field, tags, repo, links, images, playground: playgroundSlug } = project.data;
const hero = project.data.thumbnail ?? images[0];
const heroImage = images.find((image) => image.src === hero?.src);
const gallery = images.filter((image) => image.src !== hero?.src);
const playgroundLink = playground.find((item) => item.slug === playgroundSlug);
---
<BaseLayout title={title} description={summary} canonical={Astro.url.href}>
  <div class="project-head">
    <BackLink href="/projects/" label="프로젝트 목록" />
    <h1>{title}</h1>
    <p class="project-meta label numeric">
      {period && <>{period}<span aria-hidden="true"> · </span></>}
      <FieldMark field={field} />
      {tags.length > 0 && <><span aria-hidden="true"> · </span>{tags.join(' · ')}</>}
    </p>
    <p class="project-lead measure">{summary}</p>
    <div class="project-links">
      {repo && <ExternalLink href={repo} label="GitHub 저장소" />}
      {links.map((link) => <ExternalLink href={link.url} label={link.label} />)}
      {playgroundLink && <a href={`/playground/${playgroundLink.slug}/`}>플레이그라운드에서 보기</a>}
    </div>
  </div>
  <article class="project-article">
    {hero && <figure class="hero-figure">
      <img src={hero.src} alt={hero.alt} />
      <figcaption>그림 1. {heroImage?.caption ?? hero.alt}</figcaption>
    </figure>}
    <div class="prose"><Content /></div>
    {gallery.length > 0 && <div class="project-gallery">
      {gallery.map((image, index) => <figure>
        <img src={image.src} alt={image.alt} loading="lazy" />
        <figcaption>그림 {index + (hero ? 2 : 1)}. {image.caption ?? image.alt}</figcaption>
      </figure>)}
    </div>}
  </article>
  <nav class="project-neighbors" aria-label="프로젝트 이동">
    {previous ? <a href={`/projects/${previous.id}/`}><span>이전 프로젝트</span><strong>{previous.data.title}</strong></a> : <span></span>}
    {next ? <a href={`/projects/${next.id}/`}><span>다음 프로젝트</span><strong>{next.data.title}</strong></a> : <span></span>}
  </nav>
</BaseLayout>
<style>
  .project-head { padding-block: var(--s-16) var(--s-12); }
  .project-head h1 { margin-top: var(--s-6); }
  .project-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin-top: var(--s-4);
    color: var(--ink-3);
  }
  .project-lead {
    margin-top: var(--s-6);
    color: var(--ink-2);
    font-size: var(--t-body);
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    margin-top: var(--s-6);
    font-size: var(--t-small);
  }
  .project-article { max-width: 40rem; }
  .hero-figure { margin-bottom: var(--s-12); }
  figure img {
    display: block;
    max-width: 100%;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }
  figcaption {
    margin-top: var(--s-2);
    color: var(--ink-3);
    font-size: var(--t-label);
  }
  .project-gallery {
    display: grid;
    gap: var(--s-8) var(--s-6);
    margin-top: var(--s-12);
  }
  .project-neighbors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6);
    max-width: 40rem;
    margin-top: var(--s-16);
    padding-top: var(--s-6);
    border-top: 1px solid var(--rule);
  }
  .project-neighbors a { display: block; }
  .project-neighbors a:last-child { text-align: right; }
  .project-neighbors span,
  .project-neighbors strong { display: block; }
  .project-neighbors span {
    color: var(--ink-3);
    font-size: var(--t-label);
    font-weight: 500;
  }
  .project-neighbors strong { font-size: var(--t-small); font-weight: 600; }
  @media (min-width: 48rem) {
    .project-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
