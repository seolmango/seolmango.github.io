---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRows from '../components/PostRows.astro';
import ProjectCardGrid from '../components/ProjectCardGrid.astro';
import BlogEmpty from '../components/BlogEmpty.astro';
import { getProfile, getPosts, getFeaturedProjects } from '../lib/content';
import { playground } from '../lib/playground';
const profile = getProfile();
const posts = getPosts().slice(0, 5);
const projects = getFeaturedProjects(4);
---
<BaseLayout>
  <div class="page-head home-head">
    <h1>{profile.displayName}<span class="home-dot" aria-hidden="true">.</span></h1>
    <p class="measure home-tagline">{profile.tagline || profile.siteDescription}</p>
    {profile.intro.map((paragraph) => <p class="measure">{paragraph}</p>)}
  </div>
  <section class="section" aria-labelledby="projects">
    <h2 id="projects" class="section-rule">대표 프로젝트</h2>
    {projects.length
      ? <ProjectCardGrid projects={projects} entrance featured />
      : <p class="empty">대표 프로젝트를 정리하고 있습니다.</p>}
    <p class="section-more"><a href="/projects/">모든 프로젝트 보기</a></p>
  </section>
  <section class="section" aria-labelledby="recent">
    <h2 id="recent" class="section-rule">최근 글</h2>
    {posts.length ? <PostRows posts={posts}/> : <BlogEmpty/>}
    <p class="section-more">
      <a href="/blog/">모든 글 보기</a>
    </p>
  </section>
  <section class="section" aria-labelledby="playground">
    <h2 id="playground" class="section-rule">플레이그라운드</h2>
    {playground.map((item) => (
      <div class="row">
        <div class="row-label"></div>
        <div class="row-main">
          <h3><a href={`/playground/${item.slug}/`}>{item.title}</a></h3>
          <p>{item.summary}</p>
          <p class="label quiet">데모 · 실제 연구 프로젝트가 아닙니다</p>
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
<style>
  .home-head {
    max-width: 56rem;
  }
  .home-head h1 {
    font-size: clamp(2rem, 1.4rem + 3vw, 3.5rem);
  }
  .home-dot {
    color: var(--mango);
  }
  .home-tagline {
    max-width: 56rem;
    color: var(--ink-2);
    font-size: var(--t-h3);
    font-weight: 400;
    line-height: 1.5;
  }
  .section-more { margin-inline-start: 0; }
</style>
