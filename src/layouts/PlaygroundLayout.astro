---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  hook: string;
  date: Date;
  tags: string[];
}

const { title, hook, date, tags } = Astro.props;

const formattedDate = new Intl.DateTimeFormat("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(date);
---

<BaseLayout title={title} description={hook} ogType="article">
  <article class="toy">
    <header class="wrap toy-head">
      <p class="eyebrow"><a href="/playground">← 플레이그라운드로</a> / {formattedDate}</p>
      <h1>{title}</h1>
      <p class="hook">{hook}</p>
      <ul class="tags">
        {tags.map((t) => (
          <li class="chip">{t}</li>
        ))}
      </ul>
    </header>

    <div class="wrap prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .toy-head {
    padding-top: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .toy-head .eyebrow {
    margin: 0 0 1.1rem;
  }

  .toy-head .eyebrow a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .toy-head .eyebrow a:hover {
    color: var(--teal);
  }

  h1 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    max-width: 22ch;
  }

  .hook {
    margin: 0 0 1.25rem;
    max-width: var(--measure);
    color: var(--ink-soft);
    font-size: 1.1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .chip {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--teal);
  }

  .prose {
    padding-block: 2.5rem 4rem;
  }

  /* Only prose-flavoured elements get the readable measure — the toy
     itself (canvas, controls) is free to use the full wrap width. */
  .prose :global(> p),
  .prose :global(> ul:not(.tags)),
  .prose :global(> ol),
  .prose :global(> blockquote) {
    max-width: var(--measure);
  }
</style>
