---
// Usage inside any .mdx post body:
//   <YouTube id="efWby_ctrzI" caption="두 은하가 충돌하는 시뮬레이션 결과" />
interface Props {
  id: string;
  caption?: string;
  title?: string;
}

const { id, caption, title = "YouTube 영상" } = Astro.props;
---

<figure class="yt">
  <div class="frame">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${id}`}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .yt {
    margin: 2rem 0;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--ink-soft);
    text-align: center;
  }
</style>
