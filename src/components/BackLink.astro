---
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---
<a href={href} class="back-link">
  <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
    <path d="M10 6H2m4-4L2 6l4 4" />
  </svg>
  {label}
</a>
<style>
  .back-link svg {
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-right: 0.25em;
    vertical-align: baseline;
  }
</style>
