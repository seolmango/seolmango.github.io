const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap bar">
    <p class="eyebrow">LOG CLOSED {year} · 계속 기록 중</p>
    <div class="links">
      <a href="https://github.com/seolmango" target="_blank" rel="noopener noreferrer">github.com/seolmango</a>
