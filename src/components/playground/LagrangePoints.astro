---
// Ported from github.com/seolmango/threeParticle. The heatmap is the exact
// effective-potential formula from potential.py (mass ratio ALPHA for the
// Sun–Jupiter system), and every dropped/thrown trajectory integrates the
// exact rotating-frame equations of motion from trojan.py — including its
// real starting condition for the default trajectory, not a made-up one.
// L1–L3 aren't in the source scripts (only L4/L5 have a closed form); they're
// solved numerically at load time against that same equation of motion.
---

<div class="lp-toy">
  <div class="frame">
    <canvas class="view"></canvas>
    <p class="hint">클릭하면 정지 상태로, 드래그 후 놓으면 그 방향·속도로 던집니다</p>
  </div>
  <div class="controls">
    <button type="button" data-action="toggle">일시정지</button>
    <button type="button" data-action="clear">지우기</button>
    <p class="caption">
      <span class="dot amber" aria-hidden="true"></span>기본 궤적은
      trojan.py의 실제 초기값 · <span class="cross" aria-hidden="true">+</span>
      표시는 L1~L5 위치
    </p>
  </div>
</div>

<style>
  .lp-toy {
    margin: 2rem 0;
  }

  .frame {
    position: relative;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    touch-action: none;
    max-width: 640px;
    margin: 0 auto;
  }

  canvas {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
  }

  .view {
    cursor: crosshair;
  }

  .hint {
    position: absolute;
    top: 0.75rem;
    left: 0.9rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    pointer-events: none;
    text-shadow: 0 0 4px var(--paper-raised);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.9rem;
  }

  button {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule-strong);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  button:hover {
    border-color: var(--teal);
    color: var(--teal);
  }

  .caption {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .dot.amber {
    background: var(--amber);
  }

  .cross {
    color: var(--ink-soft);
    font-weight: 600;
  }
</style>

<script>
  const ALPHA = 0.000954; // Sun–Jupiter mass ratio, same as trojan.py
  const RANGE = 1.5; // display domain: [-1.5, 1.5] on both axes, same as the source scripts
  const TIME_SPEED = 0.6; // sim-time units advanced per real second
  const SUBSTEPS = 4;
  const PARTICLE_COLORS = ["--teal", "--focus", "--amber"];
  const CLICK_THRESHOLD_SIM = 0.015; // drags shorter than this (in sim units) count as a plain click
  const VELOCITY_SCALE = 0.35; // drag distance (sim units) -> launch speed
  const MAX_LAUNCH_SPEED = 1.4; // clamp so a corner-to-corner drag doesn't launch absurdly fast

  function potential(x, y) {
    const r1 = Math.sqrt((x - ALPHA) ** 2 + y * y);
    const r2 = Math.sqrt((x + 1 - ALPHA) ** 2 + y * y);
    return -(1 - ALPHA) / r1 - ALPHA / r2 - (x * x + y * y) / 2;
  }

  function derivs([x, dx, y, dy]) {
    const r1 = Math.sqrt((x - ALPHA) ** 2 + y * y);
    const r2 = Math.sqrt((x + 1 - ALPHA) ** 2 + y * y);
    const dx2 =
      (-(1 - ALPHA) * (x - ALPHA)) / r1 ** 3 - (ALPHA * (x + 1 - ALPHA)) / r2 ** 3 + 2 * dy + x;
    const dy2 = (-(1 - ALPHA) * y) / r1 ** 3 - (ALPHA * y) / r2 ** 3 - 2 * dx + y;
    return [dx, dx2, dy, dy2];
  }

  function rk4Step(state, dt) {
    const k1 = derivs(state);
    const s2 = state.map((v, i) => v + (k1[i] * dt) / 2);
    const k2 = derivs(s2);
    const s3 = state.map((v, i) => v + (k2[i] * dt) / 2);
    const k3 = derivs(s3);
    const s4 = state.map((v, i) => v + k3[i] * dt);
    const k4 = derivs(s4);
    return state.map((v, i) => v + (dt / 6) * (k1[i] + 2 * k2[i] + 2 * k3[i] + k4[i]));
  }

  // L1/L2/L3 have no closed form, so they're found by Newton's method on
  // the same acceleration function the integrator uses: at y=0 with zero
  // velocity, derivs(...)[1] is exactly d(effective potential)/dx, and a
  // Lagrange point is where that's zero.
  function collinearAccel(x) {
    return derivs([x, 0, 0, 0])[1];
  }

  function solveCollinear(x0) {
    let x = x0;
    for (let i = 0; i < 60; i++) {
      const h = 1e-6;
      const f = collinearAccel(x);
      const fp = (collinearAccel(x + h) - collinearAccel(x - h)) / (2 * h);
      const dx = f / fp;
      x -= dx;
      if (Math.abs(dx) < 1e-13) break;
    }
    return x;
  }

  const HILL_RADIUS = Math.cbrt(ALPHA / 3);
  const JUPITER_X = ALPHA - 1;
  const L1_X = solveCollinear(JUPITER_X + HILL_RADIUS); // between the Sun and Jupiter
  const L2_X = solveCollinear(JUPITER_X - HILL_RADIUS); // beyond Jupiter
  const L3_X = solveCollinear(1); // opposite Jupiter, across the Sun

  function hexToRgb(hex) {
    const clean = hex.trim().replace("#", "");
    const bigint = parseInt(clean, 16);
    return [(bigint >> 16) & 255, (bigint >> 8) & 255, bigint & 255];
  }

  function lerp(a, b, t) {
    return a + (b - a) * t;
  }

  function lerpRgb(a, b, t) {
    return [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)];
  }

  const TRAIL_LENGTH = 50;

  function initLagrangeToy(root) {
    const viewCanvas = root.querySelector("canvas.view");
    const hint = root.querySelector(".hint");
    const toggleBtn = root.querySelector('[data-action="toggle"]');
    const clearBtn = root.querySelector('[data-action="clear"]');
    const viewCtx = viewCanvas.getContext("2d");
    // The static heatmap + markers are baked into this offscreen canvas once
    // per resize, then blitted back full-opacity every frame before drawing
    // trails on top. (An earlier version faded a semi-transparent overlay
    // with destination-out — cute, but browsers store canvas pixels
    // premultiplied, so un-premultiplying very-low-alpha remnants back to
    // straight alpha amplifies rounding error and drifts the color toward
    // white. Redrawing from a pristine bitmap sidesteps that entirely.)
    const baseCanvas = document.createElement("canvas");
    const baseCtx = baseCanvas.getContext("2d");

    const style = getComputedStyle(document.documentElement);
    const tealRgb = hexToRgb(style.getPropertyValue("--teal") || "#2e6f63");
    const paperRgb = hexToRgb(style.getPropertyValue("--paper-raised") || "#f6f7f3");
    const amberRgb = hexToRgb(style.getPropertyValue("--amber") || "#b5651d");
    const inkRgb = hexToRgb(style.getPropertyValue("--ink") || "#202b26");
    const inkSoft = style.getPropertyValue("--ink-soft").trim() || "#4b564f";
    const ruleStrong = style.getPropertyValue("--rule-strong").trim() || "#9aa89c";
    const fontMono = style.getPropertyValue("--font-mono").trim() || "monospace";
    const particleColors = PARTICLE_COLORS.map((v) => style.getPropertyValue(v).trim());

    let width = 0;
    let height = 0;
    let playing = true;
    let colorCursor = 0;
    let dragStart = null; // { simX, simY, pointerId } — press point, in sim units
    let dragCurrent = null; // { simX, simY } — live pointer position while dragging

    function toPixel(x, y) {
      return [width / 2 + (x / RANGE) * (width / 2), height / 2 - (y / RANGE) * (height / 2)];
    }

    function toSim(px, py) {
      return [((px - width / 2) / (width / 2)) * RANGE, ((height / 2 - py) / (height / 2)) * RANGE];
    }

    const DEFAULT_STATE = [-0.532, 0.078, 0.92, 0.043]; // trojan.py's real "5" initial condition

    function makeDefaultParticle() {
      return { state: [...DEFAULT_STATE], color: amberRgb, history: [], alive: true };
    }

    let particles = [makeDefaultParticle()];

    function drawBase() {
      // ImageData writes raw backing pixels regardless of ctx transform, so
      // this loop maps directly in backing-pixel space (bw × bh) rather
      // than going through the CSS-pixel toSim() used everywhere else.
      const w = baseCanvas.width;
      const h = baseCanvas.height;
      const img = baseCtx.createImageData(w, h);
      let zMin = Infinity;
      let zMax = -Infinity;
      const zs = new Float32Array(w * h);
      for (let py = 0; py < h; py++) {
        for (let px = 0; px < w; px++) {
          const sx = ((px - w / 2) / (w / 2)) * RANGE;
          const sy = ((h / 2 - py) / (h / 2)) * RANGE;
          const z = Math.max(potential(sx, sy), -2);
          zs[py * w + px] = z;
          if (z < zMin) zMin = z;
          if (z > zMax) zMax = z;
        }
      }
      const span = zMax - zMin || 1;
      for (let i = 0; i < zs.length; i++) {
        const t = (zs[i] - zMin) / span;
        const rgb =
          t < 0.5 ? lerpRgb(tealRgb, paperRgb, t / 0.5) : lerpRgb(paperRgb, amberRgb, (t - 0.5) / 0.5);
        img.data[i * 4] = rgb[0];
        img.data[i * 4 + 1] = rgb[1];
        img.data[i * 4 + 2] = rgb[2];
        img.data[i * 4 + 3] = 255;
      }
      baseCtx.putImageData(img, 0, 0);

      // mass + L4/L5 markers, drawn in CSS-pixel space via the dpr transform
      baseCtx.setTransform(w / width, 0, 0, h / height, 0, 0);
      const [sunX, sunY] = toPixel(ALPHA, 0);
      const [jupX, jupY] = toPixel(ALPHA - 1, 0);
      baseCtx.fillStyle = ruleStrong;
      baseCtx.beginPath();
      baseCtx.arc(sunX, sunY, 5, 0, Math.PI * 2);
      baseCtx.fill();
      baseCtx.beginPath();
      baseCtx.arc(jupX, jupY, 3.5, 0, Math.PI * 2);
      baseCtx.fill();

      baseCtx.strokeStyle = inkSoft;
      baseCtx.font = `11px ${fontMono}`;
      baseCtx.fillStyle = inkSoft;
      // label offsets are hand-placed: L1/L2 sit right next to Jupiter and
      // to each other (real Hill-sphere geometry, not a display bug), so
      // their labels are pushed opposite directions to stay legible.
      for (const [label, sx, sy, dx, dy] of [
        ["L1", L1_X, 0, 8, 14],
        ["L2", L2_X, 0, -24, -10],
        ["L3", L3_X, 0, 7, -6],
        ["L4", ALPHA - 0.5, Math.sqrt(3) / 2, 7, -6],
        ["L5", ALPHA - 0.5, -Math.sqrt(3) / 2, 7, -6],
      ]) {
        const [lx, lyPx] = toPixel(sx, sy);
        baseCtx.beginPath();
        baseCtx.moveTo(lx - 5, lyPx);
        baseCtx.lineTo(lx + 5, lyPx);
        baseCtx.moveTo(lx, lyPx - 5);
        baseCtx.lineTo(lx, lyPx + 5);
        baseCtx.stroke();
        baseCtx.fillText(label, lx + dx, lyPx + dy);
      }
      baseCtx.setTransform(1, 0, 0, 1, 0, 0);
    }

    function resize() {
      const rect = viewCanvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      width = rect.width;
      height = rect.height;
      viewCanvas.width = width * dpr;
      viewCanvas.height = height * dpr;
      baseCanvas.width = width * dpr;
      baseCanvas.height = height * dpr;
      drawBase();
    }

    function stepParticle(p, dt) {
      if (!p.alive) return;
      const subDt = dt / SUBSTEPS;
      for (let i = 0; i < SUBSTEPS; i++) {
        p.state = rk4Step(p.state, subDt);
        const [x, , y] = p.state;
        const r1 = Math.sqrt((x - ALPHA) ** 2 + y * y);
        const r2 = Math.sqrt((x + 1 - ALPHA) ** 2 + y * y);
        if (r1 < 0.03 || r2 < 0.03 || Math.abs(x) > 3 || Math.abs(y) > 3) {
          p.alive = false;
          return;
        }
      }
    }

    let lastTime = performance.now();

    function frame(now) {
      const dt = Math.min((now - lastTime) / 1000, 1 / 30) * TIME_SPEED;
      lastTime = now;

      const dpr = (viewCanvas.width / width) || 1;
      viewCtx.setTransform(1, 0, 0, 1, 0, 0);
      viewCtx.drawImage(baseCanvas, 0, 0);
      viewCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

      for (const p of particles) {
        if (playing) stepParticle(p, dt);
        p.history.push([p.state[0], p.state[2]]);
        if (p.history.length > TRAIL_LENGTH) p.history.shift();

        const [r, g, b] = p.color;
        for (let i = 0; i < p.history.length; i++) {
          const [sx, sy] = p.history[i];
          const [px, py] = toPixel(sx, sy);
          const fade = (i + 1) / p.history.length;
          const alpha = fade * (p.alive ? 1 : 0.35);
          // A dark outline keeps the dot legible even where the heatmap
          // underneath happens to match the particle's own fill color
          // (the L4/L5 region is the same amber as the default particle).
          viewCtx.strokeStyle = `rgba(${inkRgb[0]},${inkRgb[1]},${inkRgb[2]},${alpha * 0.8})`;
          viewCtx.lineWidth = 1;
          viewCtx.fillStyle = `rgba(${r},${g},${b},${alpha})`;
          viewCtx.beginPath();
          viewCtx.arc(px, py, 2.4, 0, Math.PI * 2);
          viewCtx.fill();
          viewCtx.stroke();
        }
      }

      if (dragStart && dragCurrent) drawDragPreview();

      requestAnimationFrame(frame);
    }

    function drawDragPreview() {
      const [sxPx, syPx] = toPixel(dragStart.simX, dragStart.simY);
      const [cxPx, cyPx] = toPixel(dragCurrent.simX, dragCurrent.simY);

      viewCtx.fillStyle = inkSoft;
      viewCtx.beginPath();
      viewCtx.arc(sxPx, syPx, 3, 0, Math.PI * 2);
      viewCtx.fill();

      const dxPx = cxPx - sxPx;
      const dyPx = cyPx - syPx;
      const dist = Math.hypot(dxPx, dyPx);
      if (dist < 4) return;

      viewCtx.strokeStyle = inkSoft;
      viewCtx.lineWidth = 1.5;
      viewCtx.setLineDash([4, 3]);
      viewCtx.beginPath();
      viewCtx.moveTo(sxPx, syPx);
      viewCtx.lineTo(cxPx, cyPx);
      viewCtx.stroke();
      viewCtx.setLineDash([]);

      const angle = Math.atan2(dyPx, dxPx);
      const headLen = 7;
      for (const spread of [Math.PI / 7, -Math.PI / 7]) {
        viewCtx.beginPath();
        viewCtx.moveTo(cxPx, cyPx);
        viewCtx.lineTo(
          cxPx - headLen * Math.cos(angle - spread),
          cyPx - headLen * Math.sin(angle - spread),
        );
        viewCtx.stroke();
      }

      const dragSimDist = Math.hypot(
        dragCurrent.simX - dragStart.simX,
        dragCurrent.simY - dragStart.simY,
      );
      const speed = Math.min(dragSimDist * VELOCITY_SCALE, MAX_LAUNCH_SPEED);
      viewCtx.font = `11px ${fontMono}`;
      viewCtx.fillStyle = inkSoft;
      viewCtx.fillText(`v ≈ ${speed.toFixed(2)}`, cxPx + 8, cyPx - 8);
    }

    function pointerSim(e) {
      const rect = viewCanvas.getBoundingClientRect();
      return toSim(e.clientX - rect.left, e.clientY - rect.top);
    }

    function launchDragged(e) {
      if (!dragStart || e.pointerId !== dragStart.pointerId) return;
      const [ex, ey] = pointerSim(e);
      const rawVx = ex - dragStart.simX;
      const rawVy = ey - dragStart.simY;
      const dist = Math.hypot(rawVx, rawVy);

      let vx = 0;
      let vy = 0;
      if (dist > CLICK_THRESHOLD_SIM) {
        vx = rawVx * VELOCITY_SCALE;
        vy = rawVy * VELOCITY_SCALE;
        const speed = Math.hypot(vx, vy);
        if (speed > MAX_LAUNCH_SPEED) {
          vx = (vx / speed) * MAX_LAUNCH_SPEED;
          vy = (vy / speed) * MAX_LAUNCH_SPEED;
        }
      }

      const color = hexToRgb(particleColors[colorCursor % particleColors.length]);
      colorCursor++;
      particles.push({
        state: [dragStart.simX, vx, dragStart.simY, vy],
        color,
        history: [],
        alive: true,
      });
      playing = true;
      toggleBtn.textContent = "일시정지";
      dragStart = null;
      dragCurrent = null;
    }

    viewCanvas.addEventListener("pointerdown", (e) => {
      hint.style.display = "none";
      viewCanvas.setPointerCapture(e.pointerId);
      const [sx, sy] = pointerSim(e);
      dragStart = { simX: sx, simY: sy, pointerId: e.pointerId };
      dragCurrent = { simX: sx, simY: sy };
    });

    viewCanvas.addEventListener("pointermove", (e) => {
      if (!dragStart || e.pointerId !== dragStart.pointerId) return;
      const [sx, sy] = pointerSim(e);
      dragCurrent = { simX: sx, simY: sy };
    });

    viewCanvas.addEventListener("pointerup", launchDragged);
    viewCanvas.addEventListener("pointercancel", () => {
      dragStart = null;
      dragCurrent = null;
    });

    toggleBtn.addEventListener("click", () => {
      playing = !playing;
      toggleBtn.textContent = playing ? "일시정지" : "재생";
    });

    clearBtn.addEventListener("click", () => {
      particles = [makeDefaultParticle()];
      colorCursor = 0;
      playing = true;
      toggleBtn.textContent = "일시정지";
    });

    window.addEventListener("resize", resize);
    resize();
    requestAnimationFrame((t) => {
      lastTime = t;
      requestAnimationFrame(frame);
    });
  }

  document.querySelectorAll(".lp-toy").forEach(initLagrangeToy);
</script>
