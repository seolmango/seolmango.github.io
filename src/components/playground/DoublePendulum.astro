---
// A vanilla-JS/canvas toy: two double pendulums released from almost the
// same angle (θ₁ differs by ~0.001 rad) to make sensitive dependence on
// initial conditions visible rather than just described. Drag the canvas
// to set a new starting angle; release to watch the two paths diverge.
---

<div class="pendulum-toy">
  <div class="frame">
    <canvas></canvas>
    <p class="hint">캔버스를 드래그해서 시작 각도를 잡고 놓아보세요</p>
  </div>
  <div class="controls">
    <button type="button" data-action="toggle">일시정지</button>
    <button type="button" data-action="restart">다시 시작</button>
    <p class="caption">
      <span class="dot amber" aria-hidden="true"></span>A와
      <span class="dot teal" aria-hidden="true"></span>B는 θ₁이
      0.001 rad만큼만 다르게 출발합니다.
    </p>
  </div>
</div>

<style>
  .pendulum-toy {
    margin: 2rem 0;
  }

  .frame {
    position: relative;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    touch-action: none;
  }

  canvas {
    display: block;
    width: 100%;
    height: 420px;
    cursor: crosshair;
  }

  .hint {
    position: absolute;
    top: 0.75rem;
    left: 0.9rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    pointer-events: none;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.9rem;
  }

  button {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule-strong);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  button:hover {
    border-color: var(--teal);
    color: var(--teal);
  }

  .caption {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .dot.amber {
    background: var(--amber);
  }

  .dot.teal {
    background: var(--teal);
  }
</style>

<script>
  const G = 9.8;
  const L1 = 1;
  const L2 = 1;
  const M1 = 1;
  const M2 = 1;
  const EPSILON = 0.001;
  const SUBSTEPS = 6;

  function derivs([th1, th2, w1, w2]) {
    const delta = th1 - th2;
    const den = 2 * M1 + M2 - M2 * Math.cos(2 * delta);
    const den1 = L1 * den;
    const den2 = L2 * den;

    const dw1 =
      (-G * (2 * M1 + M2) * Math.sin(th1) -
        M2 * G * Math.sin(th1 - 2 * th2) -
        2 * Math.sin(delta) * M2 * (w2 * w2 * L2 + w1 * w1 * L1 * Math.cos(delta))) /
      den1;

    const dw2 =
      (2 *
        Math.sin(delta) *
        (w1 * w1 * L1 * (M1 + M2) +
          G * (M1 + M2) * Math.cos(th1) +
          w2 * w2 * L2 * M2 * Math.cos(delta))) /
      den2;

    return [w1, w2, dw1, dw2];
  }

  function rk4Step(state, dt) {
    const k1 = derivs(state);
    const s2 = state.map((v, i) => v + (k1[i] * dt) / 2);
    const k2 = derivs(s2);
    const s3 = state.map((v, i) => v + (k2[i] * dt) / 2);
    const k3 = derivs(s3);
    const s4 = state.map((v, i) => v + k3[i] * dt);
    const k4 = derivs(s4);
    return state.map((v, i) => v + (dt / 6) * (k1[i] + 2 * k2[i] + 2 * k3[i] + k4[i]));
  }

  function hexToRgb(hex) {
    const clean = hex.trim().replace("#", "");
    const bigint = parseInt(clean, 16);
    return [(bigint >> 16) & 255, (bigint >> 8) & 255, bigint & 255];
  }

  function initPendulum(root) {
    const canvas = root.querySelector("canvas");
    const hint = root.querySelector(".hint");
    const toggleBtn = root.querySelector('[data-action="toggle"]');
    const restartBtn = root.querySelector('[data-action="restart"]');
    const ctx = canvas.getContext("2d");

    const style = getComputedStyle(document.documentElement);
    const paperRgb = hexToRgb(style.getPropertyValue("--paper-raised") || "#f6f7f3");
    const amber = style.getPropertyValue("--amber").trim() || "#b5651d";
    const teal = style.getPropertyValue("--teal").trim() || "#2e6f63";
    const ruleStrong = style.getPropertyValue("--rule-strong").trim() || "#9aa89c";

    let width = 0;
    let height = 0;
    let pivotX = 0;
    let pivotY = 0;
    let rodPx = 0;
    let playing = true;
    let dragging = false;

    const DEFAULT_TH1 = (2 * Math.PI) / 3;
    const DEFAULT_TH2 = Math.PI;

    let a = [DEFAULT_TH1, DEFAULT_TH2, 0, 0];
    let b = [DEFAULT_TH1 + EPSILON, DEFAULT_TH2, 0, 0];

    function resize() {
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      pivotX = width / 2;
      pivotY = height * 0.32;
      rodPx = Math.min(width, height) * 0.28;
      ctx.fillStyle = `rgb(${paperRgb.join(",")})`;
      ctx.fillRect(0, 0, width, height);
    }

    function bobPositions(state) {
      const [th1, th2] = state;
      const x1 = pivotX + rodPx * Math.sin(th1);
      const y1 = pivotY + rodPx * Math.cos(th1);
      const x2 = x1 + rodPx * Math.sin(th2);
      const y2 = y1 + rodPx * Math.cos(th2);
      return [x1, y1, x2, y2];
    }

    function drawPendulum(state, color) {
      const [x1, y1, x2, y2] = bobPositions(state);
      ctx.strokeStyle = color;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(pivotX, pivotY);
      ctx.lineTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.stroke();

      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.arc(x1, y1, 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.arc(x2, y2, 6, 0, Math.PI * 2);
      ctx.fill();
    }

    function drawPivot() {
      ctx.fillStyle = ruleStrong;
      ctx.beginPath();
      ctx.arc(pivotX, pivotY, 3, 0, Math.PI * 2);
      ctx.fill();
    }

    function angleFromPointer(clientX, clientY) {
      const rect = canvas.getBoundingClientRect();
      const dx = clientX - rect.left - pivotX;
      const dy = clientY - rect.top - pivotY;
      return Math.atan2(dx, dy);
    }

    function step(dt) {
      const subDt = dt / SUBSTEPS;
      for (let i = 0; i < SUBSTEPS; i++) {
        a = rk4Step(a, subDt);
        b = rk4Step(b, subDt);
      }
    }

    let lastTime = performance.now();

    function frame(now) {
      const dt = Math.min((now - lastTime) / 1000, 1 / 30);
      lastTime = now;

      // Fade the previous frame instead of clearing it — turns the bob's
      // path into a trailing streak so the two pendulums' divergence
      // reads visually, not just as two dots moving independently.
      ctx.fillStyle = `rgba(${paperRgb.join(",")}, 0.09)`;
      ctx.fillRect(0, 0, width, height);

      if (playing && !dragging) {
        step(dt);
      }

      drawPivot();
      drawPendulum(a, amber);
      drawPendulum(b, teal);

      requestAnimationFrame(frame);
    }

    function resetTrail() {
      ctx.fillStyle = `rgb(${paperRgb.join(",")})`;
      ctx.fillRect(0, 0, width, height);
    }

    function setFromAngle(th1) {
      a = [th1, DEFAULT_TH2, 0, 0];
      b = [th1 + EPSILON, DEFAULT_TH2, 0, 0];
      resetTrail();
    }

    canvas.addEventListener("pointerdown", (e) => {
      dragging = true;
      hint.style.display = "none";
      canvas.setPointerCapture(e.pointerId);
      setFromAngle(angleFromPointer(e.clientX, e.clientY));
    });

    canvas.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      setFromAngle(angleFromPointer(e.clientX, e.clientY));
    });

    canvas.addEventListener("pointerup", () => {
      dragging = false;
      playing = true;
      toggleBtn.textContent = "일시정지";
    });

    toggleBtn.addEventListener("click", () => {
      playing = !playing;
      toggleBtn.textContent = playing ? "일시정지" : "재생";
    });

    restartBtn.addEventListener("click", () => {
      const jitter = (Math.random() - 0.5) * 0.6;
      setFromAngle(DEFAULT_TH1 + jitter);
      playing = true;
      toggleBtn.textContent = "일시정지";
    });

    window.addEventListener("resize", resize);
    resize();
    requestAnimationFrame((t) => {
      lastTime = t;
      requestAnimationFrame(frame);
    });
  }

  document.querySelectorAll(".pendulum-toy").forEach(initPendulum);
</script>
