---
import { getProfile } from '../lib/content';
import ThemeToggle from './ThemeToggle.astro';
const profile = getProfile();
const path = Astro.url.pathname;
const nav = [
  { href: '/about/', label: '소개' },
  { href: '/projects/', label: '프로젝트' },
  { href: '/blog/', label: '글' },
  { href: '/playground/', label: '플레이그라운드' },
];
---
<header class="site-header">
  <div class="plate bar">
    <a class="brand" href="/">{profile.displayName}<span class="brand-dot" aria-hidden="true"></span></a>
    <nav aria-label="주 메뉴">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={path === item.href ? 'page' : path.startsWith(item.href) ? 'true' : undefined}
        >{item.label}</a>
      ))}
    </nav>
    <ThemeToggle />
  </div>
</header>
<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--s-6);
    min-height: 4rem;
  }
  .brand {
    font-weight: 600;
    text-decoration: none;
  }
  .brand-dot {
    display: inline-block;
    width: 0.4em;
    height: 0.4em;
    margin-left: 0.3em;
    border-radius: 50%;
    background: var(--mango);
    vertical-align: 0.05em;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 1.5rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    font-size: var(--t-small);
  }
  nav a[aria-current] {
    border-color: var(--mango);
    color: var(--accent);
  }
  @media (max-width: 42rem) {
    .bar {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0 var(--s-2);
      padding-top: 0.5rem;
    }
    .brand {
      display: block;
      grid-column: 1;
      grid-row: 1;
    }
    nav {
      grid-column: 1;
      grid-row: 2;
      justify-content: flex-start;
      gap: 0 var(--s-6);
    }
    .bar :global(.theme-toggle) {
      grid-column: 2;
      grid-row: 2;
    }
    nav a {
      font-size: var(--t-label);
    }
  }
</style>
