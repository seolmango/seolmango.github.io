---
import type { Project } from '../lib/content';
interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
const fields = {
  materials: [2, 33],
  both: [37, 63],
  software: [67, 98],
} as const;
// A 320px viewport leaves 280px for the plate. Each label needs a 24px slot.
const narrowAxisWidth = 280;
const targetSize = 24;
const fieldCounts = { materials: 0, both: 0, software: 0 };
projects.forEach((project) => fieldCounts[project.field]++);
const rows = Math.max(1, ...Object.entries(fields).map(([field, [lo, hi]]) => {
  const slotsPerRow = Math.floor(((hi - lo) / 100) * narrowAxisWidth / targetSize) + 1;
  return Math.ceil(fieldCounts[field as keyof typeof fields] / slotsPerRow);
}));
const counts = { materials: 0, both: 0, software: 0 };
const points = projects.map((project, index) => {
  const [lo, hi] = fields[project.field];
  const count = fieldCounts[project.field];
  const order = counts[project.field]++;
  const row = order % rows;
  const rank = Math.floor(order / rows);
  const slots = Math.ceil((count - row) / rows);
  const step = (hi - lo) / (count + 1);
  const first = lo + step * (row + 1);
  const last = lo + step * (row + 1 + (slots - 1) * rows);
  const midpoint = (first + last) / 2;
  const offset = rank - (slots - 1) / 2;
  const labelX = offset === 0
    ? `${midpoint}cqw`
    : `calc(${midpoint}cqw ${offset < 0 ? '-' : '+'} max(${Math.abs(offset) * targetSize}px, ${Math.abs(offset) * step * rows}cqw))`;
  return {
    project,
    index: index + 1,
    x: lo + step * (order + 1),
    row,
    labelX,
  };
});
const summary = `재료과학 ${counts.materials}개, 재료와 코드 ${counts.both}개, 소프트웨어 ${counts.software}개 프로젝트`;
---
<div class="axis-wrap">
  <div class="axis" style={`--rows-height:${rows * 28}px`}>
    <div class="field-names">
      <span>재료과학</span>
      <span>재료 + 코드</span>
      <span>소프트웨어</span>
    </div>
    <svg viewBox="0 0 100 32" preserveAspectRatio="none" role="img" aria-label={summary}>
      <path d="M0 14H100" class="base" />
      <path d="M35 2V14M65 2V14" class="boundary" />
      {Array.from({ length: 21 }, (_, i) => i * 5).map((x) => (
        <path d={`M${x} 14V${x % 25 === 0 ? 23 : 19}`} class="tick" />
      ))}
      {points.map(({ x, index }) => <path d={`M${x} 4V14`} class="point" data-point-index={index} />)}
    </svg>
    {points.map(({ project, index, x, row, labelX }) => (
      <span class="axis-point" style={`--x:${x}cqw;--label-x:${labelX};--row-offset:${row * 28}px`}>
        <a
          class="point-link numeric"
          data-point-index={index}
          href={`#project-${project.id}`}
          aria-label={`${index}. ${project.title} 프로젝트로 이동`}
        >{index}</a>
      </span>
    ))}
  </div>
</div>
<style is:global set:html={points.map(({ index }) => `
  body:has(.project-row:nth-of-type(${index}):is(:hover, :focus-within)) .axis-wrap .point-link[data-point-index="${index}"] {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  body:has(.project-row:nth-of-type(${index}):is(:hover, :focus-within)) .axis-wrap .point[data-point-index="${index}"] {
    stroke-width: 3px;
  }
`).join('')} />
<style>
  .axis-wrap {
    max-width: 40rem;
    margin-block: var(--s-12) var(--s-8);
  }
  .axis {
    --axis-top: calc(1.5rem + var(--rows-height) + 0.25rem);
    height: calc(var(--axis-top) + 3.5rem);
    position: relative;
    container-type: inline-size;
  }
  .axis svg {
    width: 100%;
    height: 3.5rem;
    display: block;
    position: absolute;
    top: var(--axis-top);
  }
  .field-names {
    display: flex;
    justify-content: space-between;
    color: var(--ink-3);
    font-size: var(--t-label);
  }
  .field-names span {
    width: 33.333%;
    text-align: center;
  }
  .axis path {
    vector-effect: non-scaling-stroke;
  }
  .base,
  .tick {
    stroke: var(--rule-strong);
    stroke-width: 1px;
  }
  .boundary {
    stroke: var(--accent);
    stroke-width: 1px;
  }
  .point {
    stroke: var(--accent);
    stroke-width: 2px;
    transition: stroke-width 150ms ease-out;
  }
  .axis-point {
    position: absolute;
    left: var(--x);
    top: calc(1.5rem + var(--row-offset));
    width: 0;
    height: 0;
  }
  .axis-point::before,
  .axis-point::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }
  .axis-point::before {
    left: min(0px, calc(var(--label-x) - var(--x)));
    top: 24px;
    width: calc(max(0px, var(--label-x) - var(--x)) - min(0px, var(--label-x) - var(--x)));
    border-top: 1px solid var(--rule);
  }
  .axis-point::after {
    left: 0;
    top: 24px;
    height: calc(var(--axis-top) + 7px - 1.5rem - var(--row-offset) - 24px);
    border-left: 1px solid var(--rule);
  }
  .point-link {
    position: absolute;
    z-index: 1;
    left: calc(var(--label-x) - var(--x));
    transform: translateX(-50%);
    font-size: var(--t-label);
    color: var(--accent);
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    text-align: center;
    background: var(--ground);
    line-height: 1;
    transition: font-weight 150ms ease-out, text-decoration-color 150ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .point,
    .point-link {
      transition: none;
    }
  }
</style>
