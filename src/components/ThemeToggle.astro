<button class="theme-toggle" type="button" aria-label="어두운 화면으로 전환" title="화면 색상 전환">
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.2 15.6A8.5 8.5 0 0 1 8.4 3.8 8.5 8.5 0 1 0 20.2 15.6Z" />
  </svg>
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
  </svg>
</button>
<script is:inline>
  (() => {
    const button = document.querySelector('.theme-toggle');
    if (!button) return;
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
    const currentTheme = () => document.documentElement.dataset.theme || (systemDark.matches ? 'dark' : 'light');
    const updateLabel = () => {
      button.setAttribute('aria-label', currentTheme() === 'dark' ? '밝은 화면으로 전환' : '어두운 화면으로 전환');
    };
    updateLabel();
    systemDark.addEventListener('change', updateLabel);
    button.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Keep the selected theme for this page when storage is unavailable.
      }
      document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
        meta.setAttribute('content', next === 'dark' ? '#15181b' : '#f5f6f4');
      });
      updateLabel();
    });
  })();
</script>
<style>
  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .theme-toggle svg {
    grid-area: 1 / 1;
    transition: opacity 200ms ease-out, transform 200ms ease-out;
  }
  .sun { opacity: 0; transform: rotate(-30deg); }
  .moon { opacity: 1; transform: rotate(0); }
  :global(html[data-theme='dark']) .sun { opacity: 1; transform: rotate(0); }
  :global(html[data-theme='dark']) .moon { opacity: 0; transform: rotate(30deg); }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .sun { opacity: 1; transform: rotate(0); }
    :global(html:not([data-theme='light'])) .moon { opacity: 0; transform: rotate(30deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle svg { transition: none; }
  }
</style>
