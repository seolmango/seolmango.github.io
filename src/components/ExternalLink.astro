---
interface Props {
  href: string;
  label: string;
  class?: string;
}
const { href, label, class: className = '' } = Astro.props;
---
<a href={href} class:list={['external', className]}>
  {label}
  <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
    <path d="M2 10 10 2M4 2h6v6" />
  </svg>
</a>
