---
import type { Project } from '../lib/content';
import FieldMark from './FieldMark.astro';
import ExternalLink from './ExternalLink.astro';
import { playground } from '../lib/playground';
interface Props {
  projects: Project[];
  detailed?: boolean;
}
const { projects, detailed = false } = Astro.props;
---
{projects.map((project, index) => (
  <article class="row project-row" id={`project-${project.id}`}>
    <div class="row-label numeric">
      {index + 1}
      {detailed && project.period && <div>{project.period}</div>}
    </div>
    <div class="row-main">
      <h2>{project.title}</h2>
      <FieldMark field={project.field}/>
      <p>{project.summary}</p>
      {detailed && project.description?.map((paragraph) => <p>{paragraph}</p>)}
      {detailed && !!project.images?.length && (
        <div class="project-images">
          {project.images.map((image, imageIndex) => (
            <figure>
              <img src={image.src} alt={image.alt} loading="lazy" decoding="async" width="800" height="600" />
              <figcaption>그림 {imageIndex + 1}. {image.caption}</figcaption>
            </figure>
          ))}
        </div>
      )}
      {detailed && !!project.tags?.length && <p class="label tags">{project.tags.join(' · ')}</p>}
      <div class="project-links">
        {project.repo && <ExternalLink href={project.repo} label="GitHub 저장소" />}
        {project.links?.map((link) => link.url.startsWith('mailto:')
          ? <a href={link.url}>{link.label}</a>
          : <ExternalLink href={link.url} label={link.label} />)}
        {detailed && playground.some((item) => item.slug === project.playground) && (
          <a href={`/playground/${project.playground}/`}>플레이그라운드에서 보기</a>
        )}
      </div>
    </div>
  </article>
))}
<style>
  .row-main > p {
    margin-top: 0.5rem;
  }
  .tags {
    margin-top: 1rem;
  }
  .project-images {
    display: grid;
    gap: var(--s-6);
    margin-top: var(--s-8);
  }
  .project-images figure {
    min-width: 0;
  }
  .project-images img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background: #f5f6f4;
    border: 1px solid var(--rule);
  }
  .project-images figcaption {
    color: var(--ink-3);
    font-size: var(--t-label);
    margin-top: var(--s-2);
  }
  @media (min-width: 48rem) {
    .project-images {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .project-images figure:first-child {
      grid-column: 1 / -1;
    }
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: var(--t-small);
    margin-top: 1rem;
  }
</style>
