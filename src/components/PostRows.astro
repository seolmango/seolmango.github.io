---
import type { Post } from '../lib/content';
import { formatDate, getCategories } from '../lib/content';
import ExternalLink from './ExternalLink.astro';
import FieldMark from './FieldMark.astro';
interface Props {
  posts: Post[];
  years?: boolean;
}
const { posts, years = false } = Astro.props;
const categories = getCategories();
let year = '';
---
{posts.map((post) => {
  const nextYear = post.publishedAt.slice(0, 4);
  const showYear = years && nextYear !== year;
  year = nextYear;
  const category = categories.find((item) => item.id === post.categoryId);

  return <>
    {showYear && <h2 class="year">{nextYear}</h2>}
    <article class="row">
      <div class="row-label numeric">{formatDate(post.publishedAt)}</div>
      <div class="row-main">
        <h3><a href={`/blog/${post.id}/`}>{post.title}</a></h3>
        {post.excerpt && <p class="excerpt small">{post.excerpt}</p>}
        <p class="label provenance">
          {category ? <>{category.field && <FieldMark field={category.field} markOnly/>} {category.label}</> : '분류 없음'} · {post.isSample ? <span class="sample-label">예시 글</span> : <ExternalLink href={post.url} label="Velog 원문" />}
        </p>
      </div>
    </article>
  </>;
})}
<style>
  .year {
    font-size: var(--t-small);
    font-variant-numeric: tabular-nums;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .provenance {
    margin-top: 0.75rem;
  }
  .sample-label {
    color: var(--ink-3);
    border: 1px solid var(--rule);
    padding: 0.1em 0.4em;
  }
  .row-main h3 {
    font-size: var(--t-h3);
  }
  @media (min-width: 48rem) {
    .year {
      width: 9rem;
    }
  }
</style>
